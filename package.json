{
  "name": "dsh-mobile-remote-companion",
  "version": "0.1.0",
  "description": "Installable DSH bundle and remote companion for mobile access",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "dist/plugin.js",
  "exports": {
    ".": "./dist/plugin.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "bin": {
    "dsh-mobile-remote": "dist/cli.js"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js start",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1-rc.1",
    "commander": "^13.0.0",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
